# ---- Required ----
# PostgreSQL connection (on Railway use a reference variable: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Bot token from @BotFather. Setting this DISABLES demo login automatically.
BOT_TOKEN=123456789:replace-with-your-bot-token
# Bot username without @
BOT_USERNAME=GopCoinBot
# Same username, exposed to the browser (build-time)
NEXT_PUBLIC_BOT_USERNAME=GopCoinBot
# Numeric Telegram user id of the ONE administrator. ADMIN_ID works as an alias.
TELEGRAM_ADMIN_ID=000000000
ADMIN_ID=000000000
# Public https URL of this service (Railway domain), no trailing slash
WEBAPP_URL=https://your-service.up.railway.app
NODE_ENV=production

# ---- Strongly recommended ----
# Random 32+ char strings (e.g. `openssl rand -hex 32`). If omitted they are derived from BOT_TOKEN.
SESSION_SECRET=replace-with-random-hex
WEBHOOK_SECRET=replace-with-random-hex

# ---- Optional ----
# Short name of the Mini App created with /newapp in BotFather → referral links open the app directly:
# https://t.me/<BOT_USERNAME>/<MINIAPP_SHORT_NAME>?startapp=ref_CODE
MINIAPP_SHORT_NAME=
# Max age (seconds) of Telegram initData accepted at login (default 86400)
INIT_DATA_MAX_AGE=86400
# Set to "true" to hard-disable demo login even without BOT_TOKEN
DISABLE_DEMO_LOGIN=
# Set to "true" to stop the in-process broadcast sender on this instance
DISABLE_BROADCAST_WORKER=
# Set to "true" to disable the bot webhook auto-setup on boot
DISABLE_BOT_AUTOSETUP=
# Set to "true" to disable the daily 00:00 UTC backup to the admin's private chat
DISABLE_AUTO_BACKUP=
# BscScan API key (free) for faster on-chain verification of crypto orders
BSCSCAN_API_KEY=
